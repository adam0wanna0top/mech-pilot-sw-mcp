<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mech-pilot-sw</AssemblyName>
    <RootNamespace>MechPilot.SwMcp</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
  </ItemGroup>

  <!-- Expose internal pure helpers (e.g. DimensionFormat) to the L1 test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MechPilot.SwMcp.Tests" />
  </ItemGroup>

  <!-- M57: embed the git commit + dirty flag as AssemblyMetadata so `ping`
       can report which build is running (detect a stale long-lived server
       without guessing from the tool list). Runs at BUILD time in the repo;
       runtime needs no git. ContinueOnError → "unknown" off-repo / no-git. -->
  <Target Name="EmbedGitInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitShaExit" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>
    <PropertyGroup>
      <_GitSha Condition="'$(_GitShaExit)' != '0' or '$(_GitSha)' == ''">unknown</_GitSha>
      <_GitDirty Condition="'$(_GitStatus)' != ''">true</_GitDirty>
      <_GitDirty Condition="'$(_GitDirty)' == ''">false</_GitDirty>
    </PropertyGroup>
    <!-- AssemblyAttribute items (consumed by GetAssemblyAttributes) reliably
         emit attributes when added inside a target, unlike bare AssemblyMetadata. -->
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitSha</_Parameter1>
        <_Parameter2>$(_GitSha)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitDirty</_Parameter1>
        <_Parameter2>$(_GitDirty)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- SolidWorks 官方预编译 .NET Interop DLL (决策 #14) -->
  <!-- HintPath 绝对路径仅本机用; CI 上跳过该 ItemGroup (HasSolidWorks=false) -->
  <PropertyGroup>
    <SolidWorksRedistDir Condition="'$(SolidWorksRedistDir)' == ''">G:\solidwork\SOLIDWORKS Corp2026\SOLIDWORKS\api\redist</SolidWorksRedistDir>
    <HasSolidWorks Condition="Exists('$(SolidWorksRedistDir)\SolidWorks.Interop.sldworks.dll')">true</HasSolidWorks>
    <HasSolidWorks Condition="'$(HasSolidWorks)' == ''">false</HasSolidWorks>
    <DefineConstants Condition="'$(HasSolidWorks)' == 'true'">$(DefineConstants);HAS_SOLIDWORKS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasSolidWorks)' == 'true'">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksRedistDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksRedistDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
